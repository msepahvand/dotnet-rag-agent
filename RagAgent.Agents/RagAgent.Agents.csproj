    <PackageReference Include="Microsoft.SemanticKernel.Process.LocalRuntime" Version="1.72.0-alpha" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.*" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RagAgent.Core\RagAgent.Core.csproj" />
  </ItemGroup>

</Project>
